NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=parkolos

SESSION_TOKEN_BYTES=16
SESSION_COOKIE_NAME=parkolos_session
SESSION_COOKIE_MAX_AGE_DAYS=30

# Set false in a dedicated performance-test environment so k6 traffic never
# sends real Firebase notifications.
PUSH_NOTIFICATIONS_ENABLED=true
